# infra/.env 로 복사해서 값을 채운다 (cp .env.example .env). .env는 git에 올리지 않는다.
# 비워 둔 값은 compose.yaml의 기본값을 쓴다.

# ---- 레포 경로 (이 레포 기준 상대 경로) ----
WEB_DIR=../scrap-web
SERVER_DIR=../scrap-server
DIAGNOSIS_DIR=../scrap-diagnosis
ROUTE_DIR=../scrap-route

# ---- 열 포트 ----
WEB_PORT=5178
SERVER_PORT=8000
DIAGNOSIS_PORT=8030
ROUTE_PORT=8010

# ---- 서비스 간 토큰: 한쪽 값만 정하면 양쪽에 같이 들어간다. 영문·숫자만 쓴다 ----
# 만들기: python -c "import secrets; print(secrets.token_hex(24))"
ENGINE_SERVICE_TOKEN=
SCRAP_INTAKE_SERVICE_TOKEN=

# ---- scrap-server ----
# local이어야 개발용 로그인이 열린다 (배포는 prod)
SERVER_APP_ENV=local
JWT_SECRET=
SESSION_SECRET=
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5178
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
DIAGNOSIS_ENGINE_TIMEOUT_SECONDS=300

# ---- scrap-web (빌드할 때 들어감. 바꾸면 docker compose up -d --build web) ----
VITE_MAPBOX_ACCESS_TOKEN=
# 카카오 지도 SDK 공개 JavaScript 키. REST 키를 넣지 마세요. SDK 도메인 등록·카카오맵 ON 필요.
VITE_KAKAO_MAP_APP_KEY=
# 로그인 화면에 개발용 로그인 버튼 표시 (server가 local일 때만 동작). 배포 빌드는 false
VITE_ENABLE_DEV_LOGIN=true

# ---- scrap-diagnosis (문진 엔진) ----
# off면 AI 없이 선택지 버튼으로만 답한다
DIAGNOSIS_LLM_PROVIDER=azure
# SDK 중첩 재시도 제거 버전 기준. 추출/응답 각 최대 2번까지 시도한다.
# 이 값을 늘리면 서버 대기도 최소 4배 + 규칙·DB 여유로 함께 늘린다.
DIAGNOSIS_LLM_TIMEOUT_SECONDS=60
DIAGNOSIS_AZURE_OPENAI_ENDPOINT=
DIAGNOSIS_AZURE_OPENAI_API_KEY=
DIAGNOSIS_AZURE_OPENAI_DEPLOYMENT=
DIAGNOSIS_AZURE_OPENAI_API_VERSION=2024-10-21
# 시험성적서 스캔본·사진 읽기(OCR). true면 문서 이미지가 Azure Document Intelligence로 가고 쪽마다 과금
# 글자 있는 PDF는 false여도 읽는다. 켜려면 아래 주소·키도 넣는다
DIAGNOSIS_ALLOW_DOCUMENT_OCR=false
DIAGNOSIS_AZURE_DOCINTEL_ENDPOINT=
DIAGNOSIS_AZURE_DOCINTEL_API_KEY=

# ---- scrap-route (처리 경로 업체 검토) ----
ROUTE_AZURE_OPENAI_ENDPOINT=
ROUTE_AZURE_OPENAI_DEPLOYMENT=
ROUTE_AZURE_OPENAI_API_KEY=

# ---- 처리 경로 데이터 (server-seed) ----
# 전국 명부 JSON을 둔 폴더. 컨테이너 안에서는 /registry
REGISTRY_DIR=./data

# ---- 단일 VM 시험 배포 (docs/deploy-single-vm.md). 로컬 실행이면 비워 둔다 ----
# 넣으면 docker compose가 배포 덮어쓰기까지 읽는다
# COMPOSE_FILE=compose.yaml:compose.deploy.yaml
# VM 공용 IP의 DNS 이름. 이 이름으로 HTTPS 인증서를 받는다
SITE_ADDRESS=
# 사이트 전체 팀 비밀번호. 해시는 작은따옴표로 감싼다($ 때문)
# 해시 만들기: docker run --rm caddy:2.8 caddy hash-password --plaintext '<비밀번호>'
BASIC_AUTH_USER=
BASIC_AUTH_HASH=''

# 선택: 카카오 REST API 키 (서버에서만 사용). 사업장 주소 검색(Kakao Local)과 자동차 길찾기(Kakao Mobility)
# Azure 배포는 deploy.sh secrets가 Key Vault kakao-rest-api-key로 옮김
KAKAO_MOBILITY_REST_API_KEY=

OSRM_DEMO_ENABLED=false

# 키 없는 사업장 주소 검색 (소규모 Photon, 운영은 전용 서비스 권장)
COMPANY_GEOCODING_ENABLED=true
COMPANY_GEOCODING_URL=https://photon.komoot.io/api/
